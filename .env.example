# ============================================================
#  Reginald — configuration (copier en .env, NE JAMAIS committer .env)
# ============================================================

# ---- Discord ----
# Token du bot (Discord Developer Portal → Bot → Reset Token).
DISCORD_TOKEN=
# Serveur (guild) et salon où Reginald publie le message hebdo de disponibilités.
DISCORD_GUILD_ID=
DISCORD_AVAILABILITY_CHANNEL_ID=
# Optionnel : rôle à mentionner en tête du message (ex. "Joueur Titulaire").
# Laisser vide pour ne pas pinger de rôle.
DISCORD_MENTION_ROLE_ID=
# Optionnel : salon des annonces (#reginald) pour événements du soir, rappels
# de dates clés, saisie de résultat. Vide = même salon que les dispos.
DISCORD_ANNOUNCE_CHANNEL_ID=

# ---- Firebase / Firestore (compte de service ARCHI) ----
# Chemin vers le fichier JSON du compte de service Firebase (hors Git).
# Alternativement, fournir GOOGLE_APPLICATION_CREDENTIALS.
FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccount.json
# Optionnel : id de projet si non déductible du compte de service.
FIREBASE_PROJECT_ID=

# ---- Divers ----
# Fuseau utilisé pour le calcul du jour/semaine. Doit rester Europe/Paris.
TZ=Europe/Paris
# Niveau de log : debug | info | warn | error
LOG_LEVEL=info
